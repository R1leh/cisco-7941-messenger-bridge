[Unit]
Description=Writes Cisco 7941 SIP registration status for phone-idle.service
After=asterisk.service
Wants=asterisk.service

[Service]
ExecStart=/usr/bin/python3 /opt/phone-idle/astatus.py
Environment=SIP_ENDPOINT=100
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
